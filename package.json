{
  "name": "seqa-api-monitor",
  "version": "1.0.0",
  "description": "API Endpoint Uptime & Performance Monitor",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "server": "node --watch server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
